# Authentication environment is explicit. The local bypass is opt-in only.
APP_ENV=local
LOCAL_AUTH_BYPASS_ENABLED=false

# Configure all three together when Cognito owner authentication is enabled.
# Preview and production require all three and reject the local bypass.
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_OWNER_SUBJECT=

# Configure both together to select one exact immutable demo-publication revision.
# Leaving both empty disables the public demo route with a safe 404.
DEMO_PUBLICATION_ID=
DEMO_PUBLICATION_REVISION_ID=

# Development-only local PostgreSQL examples. These are not production secrets.
POSTGRES_DB=ai_qa_copilot
POSTGRES_USER=ai_qa_copilot
POSTGRES_PASSWORD=ai_qa_copilot_dev
POSTGRES_PORT=5432

# Alembic reads only DATABASE_URL for migration connectivity.
DATABASE_URL=postgresql+psycopg://ai_qa_copilot:ai_qa_copilot_dev@127.0.0.1:5432/ai_qa_copilot

# Server-only OpenAI credential for an intentional synthetic analysis run.
# Leaving it empty makes the analysis route fail closed with a correlation ID.
OPENAI_API_KEY=

# Next.js development proxy target. Keep this server-only value aligned with the API port.
API_BASE_URL=http://127.0.0.1:8000
